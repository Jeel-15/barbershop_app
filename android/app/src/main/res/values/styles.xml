<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts. Dark ink behind transparent system bars:
         the status bar shows the clock and battery in white on the splash colour
         (see values-v23 for the icon colour, values-v28 for the camera cut-out). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The window behind the Flutter UI once it is running (visible only for a moment
         at start, while the phone turns and when the activity is restored). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
